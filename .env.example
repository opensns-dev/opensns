# OpenSNS Docker Compose Configuration
# Copy this file to .env and fill in the values

# ===========================================
# REQUIRED - Must be set before starting
# ===========================================

# Security keys (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=
API_KEY_ENCRYPTION_KEY=

# Debug mode (enables SQL echo, disables generic error handler)
DEBUG=false

# ===========================================
# OPTIONAL - Versioning
# ===========================================

# Docker image version tag
VERSION=latest

# ===========================================
# OPTIONAL - AI Engines
# ===========================================

# OpenAI (GPT-4o)
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# Groq (fast open-source models)
GROQ_API_KEY=

# Fal.ai (for image/video generation)
FAL_KEY=

# ===========================================
# OPTIONAL - UGC Video Engines
# ===========================================

# HeyGen API Key (for AI avatar videos)
HEYGEN_API_KEY=

# D-ID API Key (for AI avatar videos)
DID_API_KEY=

# SadTalker URL (self-hosted, for AI avatar videos)
SADTALKER_URL=

# ===========================================
# OPTIONAL - Default Engines
# ===========================================

# LLM: openai, anthropic, gemini, groq, ollama
DEFAULT_LLM_ENGINE=openai

# Image: fal, flux-pro, comfyui
DEFAULT_IMAGE_ENGINE=fal

# Video: fal-video, runway, comfyui-video
DEFAULT_VIDEO_ENGINE=fal-video

# UGC Video: heygen, d-id, sadtalker
DEFAULT_UGC_ENGINE=heygen

# ===========================================
# OPTIONAL - Local/Self-hosted Engines
# ===========================================

# Ollama URL (for local LLM)
OLLAMA_URL=

# ComfyUI URL (for local image/video generation)
COMFYUI_URL=

# ===========================================
# OPTIONAL - External URLs
# ===========================================

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:3000

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# API URL for frontend (change for production)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ===========================================
# OPTIONAL - Billing (Paddle)
# ===========================================
# ⚠️  For production: set PADDLE_ENVIRONMENT=production
#     and use production API keys from https://vendors.paddle.com

PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox
PADDLE_PRICE_ID_BASIC=
PADDLE_PRICE_ID_PRO=
PADDLE_PRICE_ID_ULTRA=
PADDLE_PRICE_ID_CREDITS_50=
PADDLE_PRICE_ID_CREDITS_150=
PADDLE_PRICE_ID_CREDITS_500=

# ===========================================
# OPTIONAL - Email (Resend)
# ===========================================

RESEND_API_KEY=
EMAIL_FROM=

# ===========================================
# OPTIONAL - OAuth
# ===========================================

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===========================================
# OPTIONAL - Error Monitoring
# ===========================================

# Sentry DSN (get from https://sentry.io)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ===========================================
# OPTIONAL - Database
# ===========================================

# PostgreSQL password (default: opensns_password)
POSTGRES_PASSWORD=opensns_password
