---
import Default from '@astrojs/starlight/components/Footer.astro';
---

<div class="cta-banner">
  <div class="cta-banner-inner">
    <p class="cta-text">Generate ad creatives from any product URL. Open source, self-hostable, free tier available.</p>
    <a href="https://opensns.pages.dev" class="cta-link">Try OpenSNS Free &rarr;</a>
  </div>
</div>

<Default><slot /></Default>

<style>
  .cta-banner {
    border-top: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg-nav);
    padding: 1.5rem 1rem;
    text-align: center;
    margin-top: 3rem;
  }

  .cta-banner-inner {
    max-width: 42rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .cta-text {
    font-size: 0.9rem;
    color: var(--sl-color-gray-2);
    margin: 0;
    line-height: 1.5;
  }

  .cta-link {
    display: inline-block;
    padding: 0.5rem 1.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--sl-color-white);
    background: var(--sl-color-accent);
    border-radius: 0.375rem;
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .cta-link:hover {
    opacity: 0.9;
    text-decoration: none;
    color: var(--sl-color-white);
  }

  @media (min-width: 40rem) {
    .cta-banner-inner {
      flex-direction: row;
      justify-content: center;
    }
  }
</style>
