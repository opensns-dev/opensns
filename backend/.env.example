# OpenSNS Backend Configuration

# Project
PROJECT_NAME=OpenSNS

# Database
DATABASE_URL=sqlite:///./opensns.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/opensns

# Redis (for future job queue)
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Engine API Keys
OPENAI_API_KEY=sk-your-openai-api-key
FAL_KEY=your-fal-ai-api-key

# Local Engine URLs (optional)
OLLAMA_URL=http://localhost:11434
COMFYUI_URL=http://localhost:8188

# Default Engine Selection
# LLM options: openai, ollama, mock
DEFAULT_LLM_ENGINE=openai
# Image options: fal, flux-pro, comfyui
DEFAULT_IMAGE_ENGINE=fal
# Video options: fal-video, runway, comfyui-video
DEFAULT_VIDEO_ENGINE=fal-video

# Encryption key for storing user API keys (min 32 chars)
API_KEY_ENCRYPTION_KEY=your-32-byte-encryption-key-here-change-me
