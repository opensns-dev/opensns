# OpenSNS Backend Configuration

# Project
PROJECT_NAME=OpenSNS

# Debug mode (set to true for development, false for production)
DEBUG=false

# Error Monitoring (Sentry)
# Get your DSN from https://sentry.io
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Database
DATABASE_URL=sqlite:///./opensns.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/opensns

# Redis (for future job queue)
REDIS_URL=redis://localhost:6379/0

# JWT Authentication (REQUIRED - generate with: openssl rand -hex 32)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Engine API Keys
OPENAI_API_KEY=sk-your-openai-api-key
FAL_KEY=your-fal-ai-api-key

# UGC Video Engine API Keys (optional - users can provide their own in settings)
HEYGEN_API_KEY=your-heygen-api-key
DID_API_KEY=your-d-id-api-key

# Local Engine URLs (optional)
OLLAMA_URL=http://localhost:11434
COMFYUI_URL=http://localhost:8188
SADTALKER_URL=http://localhost:7860

# Default Engine Selection
# LLM options: openai, ollama, mock
DEFAULT_LLM_ENGINE=openai
# Image options: fal, flux-pro, comfyui
DEFAULT_IMAGE_ENGINE=fal
# Video options: fal-video, runway, comfyui-video
DEFAULT_VIDEO_ENGINE=fal-video
# UGC Video options: heygen, d-id, sadtalker
DEFAULT_UGC_ENGINE=heygen

# Encryption key for storing user API keys (REQUIRED - generate with: openssl rand -hex 32)
API_KEY_ENCRYPTION_KEY=

# Frontend URL (for email links and redirects)
FRONTEND_URL=http://localhost:3000

# CORS Origins (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Paddle Billing
# ⚠️  Production checklist:
#   1. Create a Paddle production account at https://vendors.paddle.com
#   2. Generate production API key and webhook secret
#   3. Set PADDLE_ENVIRONMENT=production
#   4. Create products/prices in Paddle dashboard and copy price IDs below
#   5. Configure webhook URL: https://your-api-domain.com/billing/webhook
PADDLE_API_KEY=your-paddle-api-key
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxx
PADDLE_ENVIRONMENT=sandbox
# Subscription price IDs (from Paddle dashboard)
PADDLE_PRICE_ID_BASIC=pri_xxx
PADDLE_PRICE_ID_PRO=pri_xxx
PADDLE_PRICE_ID_ULTRA=pri_xxx
# Credit pack price IDs (one-time purchases)
PADDLE_PRICE_ID_CREDITS_50=pri_xxx
PADDLE_PRICE_ID_CREDITS_150=pri_xxx
PADDLE_PRICE_ID_CREDITS_500=pri_xxx

# Email (Resend)
RESEND_API_KEY=re_xxx
EMAIL_FROM=OpenSNS <noreply@yourdomain.com>

# Google OAuth
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
